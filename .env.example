# ============================================================
# 知微（ZhiWei）智能体平台 — 环境变量模板
# ------------------------------------------------------------
# 用法：
#   1. 复制本文件为 .env
#   2. 填入真实的密钥与密码
#   3. .env 已在 .gitignore 中，不会被提交
# 注意：所有值都是占位符，请勿把真实密钥写进本文件
# ============================================================

# ---------- 应用 ----------
APP_PORT=8000

# ---------- MySQL ----------
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=ziwei

# ---------- PostgreSQL（可选，仅 PgVector 方案需要）----------
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=change-me
PG_DB=vector_store

# ---------- Qdrant 向量库 ----------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=your-qdrant-api-key

# ---------- LLM 接口（OpenAI 兼容）----------
# 任一兼容 OpenAI 协议的服务都可以，例如阿里云百炼、通义、自建网关
LLM_BASE_URL=https://your-llm-endpoint/compatible-mode/v1
LLM_API_KEY=sk-your-llm-api-key
LLM_MODEL=qwen-plus

# 兼容旧变量名（部分脚本仍在使用）
MIMO_API_KEY=sk-your-llm-api-key
DASHSCOPE_API_KEY=sk-your-llm-api-key

# ---------- MinerU 文档解析（可选）----------
# 不配置时只能使用 Tika 解析器，图片理解功能不可用
MINERU_TOKEN=

# ---------- 安全 ----------
# JWT 签名密钥，至少 32 字节随机字符串
# 生成方式：openssl rand -base64 32
JWT_SECRET=please-generate-a-random-32-byte-secret

# 首次启动时创建的管理员密码
# 启动成功后请立即登录修改
INIT_ADMIN_PASSWORD=change-me-on-first-login
